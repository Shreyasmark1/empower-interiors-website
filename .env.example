# PostgreSQL connection string used by the app and drizzle-kit.
DATABASE_URL=postgres://user:password@localhost:5432/empower_interiors

# Secret used to sign and verify admin JWTs (HS256). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Token lifetime, e.g. 1h, 12h, 7d.
JWT_EXPIRES_IN=7d

# S3 storage for uploaded product images.
# S3_BUCKET is required for image uploads/serving. Credentials fall back to the
# AWS default credential chain (IAM) when the keys below are absent.
S3_BUCKET=empower-interiors-images
AWS_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: set for LocalStack/MinIO during local development.
S3_ENDPOINT=